# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Nodemailer SMTP Configuration for Internship Applications
# To send directly to contactalsinfonet@gmail.com using Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Set SMTP_USER and SMTP_PASS below (or in Vercel Project Settings -> Environment Variables)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="contactalsinfonet@gmail.com"
SMTP_PASS="your-16-character-app-password"
RECIPIENT_EMAIL="contactalsinfonet@gmail.com"
